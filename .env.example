# Copy to .env and adjust.

# --- storage ---------------------------------------------------------------
RAG_DATA_DIR=./data
RAG_UPLOAD_DIR=./data/uploads
RAG_ARTIFACT_DIR=./artifacts

# SQLite by default; PostgreSQL for a shared deployment:
# RAG_DATABASE_URL=postgresql+psycopg://rag_assistant:rag_assistant@localhost:5432/rag_assistant
RAG_DATABASE_URL=sqlite:///./data/rag_assistant.db

# --- vector store ----------------------------------------------------------
# Leave empty to use Qdrant in local (embedded) mode on disk.
# RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_PATH=./.qdrant
RAG_QDRANT_COLLECTION=rag_assistant_chunks

# --- embeddings ------------------------------------------------------------
# auto | sentence-transformers | hashing
RAG_EMBEDDING_BACKEND=auto
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_HASHING_DIMENSIONS=768

# --- chunking & retrieval --------------------------------------------------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_RETRIEVAL_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.2

# --- LLM -------------------------------------------------------------------
# auto | openai | extractive
# `auto` uses OpenAI when RAG_LLM_API_KEY is set, otherwise the built-in
# extractive answerer so the demo works without an API key.
RAG_LLM_PROVIDER=auto
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_BASE_URL=https://api.openai.com/v1
# RAG_LLM_API_KEY=sk-...

# --- app -------------------------------------------------------------------
RAG_MAX_UPLOAD_MB=20
RAG_MAX_HISTORY_MESSAGES=8
RAG_QUERY_EXPANSION=true
RAG_LOG_LEVEL=INFO
