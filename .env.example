# Copy to .env and adjust.

# --- storage ---------------------------------------------------------------
SOURCEIQ_DATA_DIR=./data
SOURCEIQ_UPLOAD_DIR=./data/uploads
SOURCEIQ_ARTIFACT_DIR=./artifacts

# SQLite by default; PostgreSQL for a shared deployment:
# SOURCEIQ_DATABASE_URL=postgresql+psycopg://sourceiq:sourceiq@localhost:5432/sourceiq
SOURCEIQ_DATABASE_URL=sqlite:///./data/sourceiq.db

# --- vector store ----------------------------------------------------------
# Leave empty to use Qdrant in local (embedded) mode on disk.
# SOURCEIQ_QDRANT_URL=http://localhost:6333
SOURCEIQ_QDRANT_PATH=./.qdrant
SOURCEIQ_QDRANT_COLLECTION=sourceiq_chunks

# --- embeddings ------------------------------------------------------------
# auto | sentence-transformers | hashing
SOURCEIQ_EMBEDDING_BACKEND=auto
SOURCEIQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SOURCEIQ_HASHING_DIMENSIONS=768

# --- chunking & retrieval --------------------------------------------------
SOURCEIQ_CHUNK_SIZE=1000
SOURCEIQ_CHUNK_OVERLAP=150
SOURCEIQ_RETRIEVAL_TOP_K=5
SOURCEIQ_MIN_RELEVANCE_SCORE=0.2

# --- LLM -------------------------------------------------------------------
# auto | openai | extractive
# `auto` uses OpenAI when SOURCEIQ_LLM_API_KEY is set, otherwise the built-in
# extractive answerer so the demo works without an API key.
SOURCEIQ_LLM_PROVIDER=auto
SOURCEIQ_LLM_MODEL=gpt-4o-mini
SOURCEIQ_LLM_BASE_URL=https://api.openai.com/v1
# SOURCEIQ_LLM_API_KEY=sk-...

# --- app -------------------------------------------------------------------
SOURCEIQ_MAX_UPLOAD_MB=20
SOURCEIQ_MAX_HISTORY_MESSAGES=8
SOURCEIQ_QUERY_EXPANSION=true
SOURCEIQ_LOG_LEVEL=INFO
